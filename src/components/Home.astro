---
// Homepage body for edgefetch.dev. Rendered below the custom Hero on the splash page.
const trace = [
	{ step: 'robots.txt', detail: 'path allowed for EdgeFetch', time: '' },
	{ step: 'dial check', detail: 'resolved IP is public, connect allowed', time: '' },
	{ step: 'dns', detail: 'resolved', time: '12 ms' },
	{ step: 'connect', detail: 'TCP to port 443', time: '9 ms' },
	{ step: 'tls', detail: 'TLS 1.3, HTTP/2', time: '21 ms' },
	{ step: 'first byte', detail: '200 OK', time: '64 ms' },
	{ step: 'markdown', detail: 'navigation and footer removed, code blocks kept', time: '' },
];

const refusals = [
	{
		title: 'It reads robots.txt first, every time',
		body: 'Checked before the first request and again on every redirect hop, using the RFC 9309 rules.',
	},
	{
		title: 'It stops at CAPTCHAs',
		body: 'Cloudflare, Akamai, DataDome and other challenge pages end the fetch with blocked: true. No stealth plugins, no solvers.',
	},
	{
		title: 'It backs off when asked',
		body: 'A 429 or 503 with Retry-After puts that host on cooldown across your whole fleet.',
	},
	{
		title: 'It never touches your LAN',
		body: 'Resolved IPs are checked inside the dialer, right before connect, so DNS rebinding can’t reach your router or Home Assistant.',
	},
];
---

<div class="ef-home not-content">
	<section class="ef-section" aria-labelledby="ef-trace-title">
		<div class="ef-section__head">
			<h2 id="ef-trace-title">One request, start to finish</h2>
			<p>
				Your agent asks for a page. Before anything leaves your network, EdgeFetch checks
				whether it’s allowed and where it’s going. Every fetch records the same timing fields,
				and you can send them to any OpenTelemetry collector.
			</p>
		</div>

		<figure class="ef-trace">
			<div class="ef-trace__cmd">
				<span class="ef-prompt" aria-hidden="true">$</span>
				<code>edgefetch scrape https://go.dev/doc/effective_go</code>
			</div>
			<ol class="ef-trace__steps">
				{
					trace.map((t, i) => (
						<li style={`--i:${i}`}>
							<span class="ef-trace__step">{t.step}</span>
							<span class="ef-trace__detail">{t.detail}</span>
							<span class="ef-trace__time">{t.time}</span>
						</li>
					))
				}
			</ol>
			<figcaption>An example trace. Timings vary with your network.</figcaption>
		</figure>
	</section>

	<section class="ef-section ef-section--split" aria-labelledby="ef-rules-title">
		<div class="ef-section__head">
			<h2 id="ef-rules-title">Polite by default, and you can’t turn that off</h2>
			<p>
				Site owners see a clear user agent and get their rules respected. These aren’t settings.
				They’re how the fetcher is built.
			</p>
			<p><a href="/concepts/politeness/">Read the politeness rules</a></p>
		</div>
		<dl class="ef-rules">
			{
				refusals.map((r) => (
					<div>
						<dt>{r.title}</dt>
						<dd>{r.body}</dd>
					</div>
				))
			}
		</dl>
	</section>

	<section class="ef-section ef-section--split" aria-labelledby="ef-verify-title">
		<div class="ef-section__head">
			<h2 id="ef-verify-title">Check the release yourself</h2>
			<p>
				Every release ships SHA-256 checksums signed with Ed25519 and GitHub SLSA build
				provenance for each archive and container image. CI runs <code>go vet</code>,
				<code>staticcheck</code>, <code>govulncheck</code>, the race detector and fuzz tests on
				every push. The Go worker has one external dependency.
			</p>
			<p><a href="/guides/verify-release/">Verify a release step by step</a></p>
		</div>
		<pre class="ef-code"><code><span class="c"># signature over the checksums</span>
openssl pkeyutl -verify -pubin -inkey release-signing-pub.pem \
  -rawin -in checksums.txt -sigfile checksums.txt.sig

<span class="c"># provenance from the GitHub Actions build</span>
gh attestation verify edgefetch_&lt;version&gt;_linux_amd64.tar.gz \
  --repo bartrumb/edgefetch</code></pre>
	</section>

	<section class="ef-start" aria-labelledby="ef-start-title">
		<h2 id="ef-start-title">Pick where to start</h2>
		<ul>
			<li><a href="/start/mcp-clients/"><strong>Use it from your editor</strong><span>Run it locally over stdio for Claude Code, Claude Desktop or Cursor.</span></a></li>
			<li><a href="/deploy/one-click/"><strong>Run a hub</strong><span>One-click deploys to Cloudflare, Render, Railway, Deno or Home Assistant.</span></a></li>
			<li><a href="/adapters/"><strong>Browse the adapters</strong><span>Job boards, package registries and open data, with no API keys.</span></a></li>
			<li><a href="/site-owners/"><strong>Saw us in your logs?</strong><span>What EdgeFetch is, and how to block or contact it.</span></a></li>
		</ul>
	</section>
</div>

<style>
	.ef-home {
		max-width: 72rem;
		margin-inline: auto;
	}
	.ef-section {
		padding-block: clamp(2.5rem, 6vw, 4.5rem);
		border-bottom: 1px solid var(--sl-color-gray-5);
	}
	.ef-section--split {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(1.5rem, 4vw, 4rem);
		align-items: start;
	}
	.ef-section__head {
		max-width: 38rem;
	}
	h2 {
		font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.25rem);
		line-height: 1.12;
		font-weight: 750;
		letter-spacing: -0.025em;
		color: var(--sl-color-white);
		margin: 0;
	}
	.ef-section__head p {
		margin-top: 0.9rem;
		color: var(--sl-color-gray-2);
		line-height: 1.6;
	}
	.ef-home a {
		color: var(--sl-color-accent);
		font-weight: 600;
		text-underline-offset: 3px;
	}
	.ef-home code {
		font-family: var(--sl-font-mono);
		font-size: 0.875em;
	}

	/* Trace */
	.ef-trace {
		margin: 2rem 0 0;
		max-width: 52rem;
		border: 1px solid #22384f;
		border-radius: 10px;
		background: #0b1522;
		color: #c9d6e3;
		font-family: var(--sl-font-mono);
		font-size: 0.875rem;
		overflow: hidden;
	}
	.ef-trace__cmd {
		padding: 0.9rem 1.1rem;
		border-bottom: 1px solid #1c2f44;
		color: #e6edf5;
		overflow-x: auto;
		white-space: nowrap;
	}
	.ef-trace__cmd code {
		font-size: 1em;
		background: none;
		color: inherit;
	}
	.ef-prompt {
		color: #3fc6e0;
		margin-right: 0.6rem;
	}
	.ef-trace__steps {
		list-style: none;
		margin: 0;
		padding: 0.6rem 0;
	}
	.ef-trace__steps li {
		display: grid;
		grid-template-columns: 7.5rem 1fr auto;
		gap: 1rem;
		padding: 0.35rem 1.1rem;
		margin: 0;
		animation: ef-step 0.35s ease-out both;
		animation-delay: calc(var(--i) * 140ms + 200ms);
	}
	.ef-trace__step {
		color: #3fc6e0;
	}
	.ef-trace__steps li:nth-child(-n + 2) .ef-trace__step {
		color: #f2a93b;
	}
	.ef-trace__time {
		color: #8a9bb0;
		text-align: right;
	}
	.ef-trace figcaption {
		padding: 0.6rem 1.1rem 0.9rem;
		color: #6f8299;
		font-family: var(--sl-font);
		font-size: 0.8125rem;
	}
	@keyframes ef-step {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.ef-trace__steps li {
			animation: none;
		}
	}

	/* Rules */
	.ef-rules {
		margin: 0;
		display: grid;
		gap: 1.5rem;
	}
	.ef-rules > div {
		padding-left: 1rem;
		border-left: 3px solid #f2a93b;
	}
	.ef-rules dt {
		font-weight: 700;
		color: var(--sl-color-white);
		font-size: 1.0625rem;
	}
	.ef-rules dd {
		margin: 0.3rem 0 0;
		color: var(--sl-color-gray-2);
		line-height: 1.55;
	}

	/* Architecture */
	.ef-arch {
		margin-top: 2rem;
		width: 100%;
		max-width: 52rem;
		height: auto;
		color: var(--sl-color-gray-3);
		font-family: var(--sl-font);
	}
	.ef-arch text {
		text-anchor: middle;
		font-size: 15px;
		font-weight: 600;
		fill: var(--sl-color-white);
	}
	.ef-arch .ef-arch__sub {
		font-size: 12.5px;
		font-weight: 400;
		fill: var(--sl-color-gray-3);
	}
	.ef-arch .ef-arch__label {
		font-size: 12.5px;
		font-weight: 500;
		fill: var(--sl-color-gray-3);
	}
	.ef-arch__box rect {
		fill: var(--sl-color-gray-6);
		stroke: var(--sl-color-gray-5);
	}
	.ef-arch__box--hub rect {
		stroke: #3fc6e0;
		stroke-width: 1.5;
	}
	.ef-arch__home {
		fill: none;
		stroke: var(--sl-color-gray-4);
		stroke-dasharray: 5 5;
	}
	.ef-arch__line {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
	}
	.ef-arch__line--out {
		stroke: #3fc6e0;
		color: #3fc6e0;
	}
	.ef-more {
		margin-top: 1rem;
	}

	/* Verify */
	.ef-code {
		margin: 0;
		padding: 1.1rem 1.25rem;
		border-radius: 10px;
		background: #0b1522;
		border: 1px solid #22384f;
		color: #d6e2ee;
		font-family: var(--sl-font-mono);
		font-size: 0.8125rem;
		line-height: 1.7;
		overflow-x: auto;
	}
	.ef-code code {
		background: none;
		font-size: 1em;
	}
	.ef-code .c {
		color: #6f8299;
	}

	/* Start */
	.ef-start {
		padding-block: clamp(2.5rem, 6vw, 4rem);
	}
	.ef-start ul {
		list-style: none;
		padding: 0;
		margin: 1.25rem 0 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}
	.ef-start li {
		margin: 0;
	}
	.ef-start a {
		display: block;
		height: 100%;
		padding: 1rem 1.1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 8px;
		text-decoration: none;
	}
	.ef-start a:hover {
		border-color: var(--sl-color-accent);
	}
	.ef-start strong {
		display: block;
		color: var(--sl-color-white);
	}
	.ef-start span {
		display: block;
		margin-top: 0.3rem;
		font-weight: 400;
		color: var(--sl-color-gray-3);
		font-size: 0.9375rem;
		line-height: 1.5;
	}

	@media (max-width: 50rem) {
		.ef-section--split,
		.ef-start ul {
			grid-template-columns: minmax(0, 1fr);
		}
		.ef-trace__steps li {
			grid-template-columns: 6rem 1fr;
		}
		.ef-trace__time {
			grid-column: 2;
			text-align: left;
		}
	}
</style>
