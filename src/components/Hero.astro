---
import { Image } from 'astro:assets';
import raven from '../assets/edgefetch-raven.png';

const install = 'go install github.com/bartrumb/edgefetch/v2/cmd/edgefetch@latest';
---

<section class="ef-hero not-content" aria-labelledby="ef-hero-title">
	<div class="ef-hero__inner">
		<div class="ef-hero__copy">
			<h1 id="ef-hero-title">The web, fetched politely, on hardware you own.</h1>
			<p class="ef-hero__lede">
				EdgeFetch is a self-hosted scraping, search, and federated MCP hub for AI agents. One
				small Go binary turns pages into clean Markdown, while your hub connects external MCP
				servers and home worker nodes with zero open ports and no per-page bill.
			</p>

			<div class="ef-install">
				<code id="ef-install-cmd">{install}</code>
				<button type="button" class="ef-copy" data-copy={install} aria-label="Copy install command">
					Copy
				</button>
			</div>

			<div class="ef-hero__actions">
				<a class="ef-btn ef-btn--primary" href="/start/quick-start/">Read the quick start</a>
				<a class="ef-btn" href="https://github.com/bartrumb/edgefetch">Source on GitHub</a>
			</div>

			<p class="ef-hero__facts">
				v2.7.1 · Open-source worker, SDKs &amp; adapters (MIT). Fair-source hub (FSL-1.1, MIT after two years). Live on the Official MCP Registry. Respects robots.txt on every hop.
			</p>
		</div>

		<div class="ef-hero__art">
			<Image
				src={raven}
				alt="The EdgeFetch raven perched on a circuit-board ledge"
				widths={[360, 560, 840]}
				sizes="(max-width: 50rem) 80vw, 560px"
				loading="eager"
				fetchpriority="high"
			/>
		</div>
	</div>
</section>

<script>
	for (const btn of document.querySelectorAll<HTMLButtonElement>('.ef-copy')) {
		btn.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(btn.dataset.copy ?? '');
				btn.textContent = 'Copied';
			} catch {
				btn.textContent = 'Press Ctrl+C';
				const code = btn.previousElementSibling;
				if (code) getSelection()?.selectAllChildren(code);
			}
			setTimeout(() => (btn.textContent = 'Copy'), 1800);
		});
	}
</script>

<style>
	.ef-hero {
		/* full-bleed band that matches the logo's own background */
		/* full-bleed band without horizontal overflow: paint outward, clip at the viewport */
		background: #101c2c;
		box-shadow: 0 0 0 100vmax #101c2c;
		clip-path: inset(-1.5rem -100vmax 0);
		color: #e6edf5;
		padding-block: clamp(1.5rem, 5vw, 4rem) clamp(2.5rem, 5vw, 4.5rem);
	}
	.ef-hero__inner {
		max-width: 72rem;
		margin-inline: auto;
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		align-items: center;
		gap: clamp(1.5rem, 4vw, 4rem);
	}
	h1 {
		font-size: clamp(2.4rem, 1.4rem + 3.6vw, 4.25rem);
		line-height: 1.02;
		font-weight: 800;
		letter-spacing: -0.035em;
		color: #ffffff;
		max-width: 14ch;
		margin: 0;
	}
	.ef-hero__lede {
		margin-top: 1.25rem;
		font-size: 1.1875rem;
		line-height: 1.55;
		color: #b9c7d6;
		max-width: 36rem;
	}
	.ef-install {
		margin-top: 1.75rem;
		display: flex;
		align-items: stretch;
		max-width: 36rem;
		border: 1px solid #2a4560;
		border-radius: 8px;
		background: #0b1522;
		overflow: hidden;
	}
	.ef-install code {
		flex: 1;
		min-width: 0;
		padding: 0.75rem 0.9rem;
		font-family: var(--sl-font-mono);
		font-size: 0.875rem;
		color: #a8ecf8;
		background: none;
		white-space: nowrap;
		overflow-x: auto;
		scrollbar-width: none;
	}
	.ef-install code::-webkit-scrollbar {
		display: none;
	}
	.ef-copy {
		border: 0;
		border-left: 1px solid #2a4560;
		background: #13253a;
		color: #e6edf5;
		font: 600 0.8125rem var(--sl-font);
		padding: 0 1rem;
		cursor: pointer;
	}
	.ef-copy:hover {
		background: #1b3350;
	}
	.ef-hero__actions {
		margin-top: 1.25rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.ef-btn {
		display: inline-block;
		padding: 0.7rem 1.15rem;
		border-radius: 8px;
		border: 1px solid #36536f;
		color: #e6edf5;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.9375rem;
	}
	.ef-btn:hover {
		border-color: #3fc6e0;
	}
	.ef-btn--primary {
		background: #3fc6e0;
		border-color: #3fc6e0;
		color: #08202a;
	}
	.ef-btn--primary:hover {
		background: #6fd7ea;
		border-color: #6fd7ea;
	}
	.ef-hero__facts {
		margin-top: 1.5rem;
		font-size: 0.875rem;
		color: #8a9bb0;
	}
	.ef-hero__art img {
		width: 115%;
		max-width: none;
		margin-inline: -7.5%;
		height: auto;
		display: block;
		/* the artwork's own background is the band colour; soften only the outer edge */
		mask-image: radial-gradient(closest-side, #000 80%, transparent 100%);
		-webkit-mask-image: radial-gradient(closest-side, #000 80%, transparent 100%);
	}

	@media (max-width: 50rem) {
		.ef-hero__inner {
			grid-template-columns: minmax(0, 1fr);
		}
		.ef-hero__art {
			order: -1;
			max-width: 18rem;
			margin-inline: auto;
		}
	}
</style>
